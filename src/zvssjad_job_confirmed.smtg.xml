                    &lt;tbody&gt;
                      &lt;tr&gt;
                        &lt;td style=&quot;font-family: Calibri, sans-serif; font-size: 15px;&quot;&gt;Dear Customer,&lt;/td&gt;
                      &lt;/tr&gt;
                      &lt;tr&gt;
                        &lt;td style=&quot;padding: 20px 0 30px 0; font-family: Calibri, open-sans; font-size: 15px;&quot;&gt;
                          &lt;p&gt;Thank you very much for the confirmation!&lt;/p&gt;
                          &lt;p&gt;The additional job for the vehicle &lt;b&gt;{LIC_PLATE}&lt;/b&gt;, will be carried out at the estimated cost of &lt;b&gt;{COST} {CURRENCY}&lt;/b&gt;.&lt;/p&gt;
                          &lt;p&gt;Job description: {JOB_DESCRIPTION}&lt;/p&gt;
                          &lt;p&gt;We look forward to seeing you!&lt;/p&gt;
                        &lt;/td&gt;
                      &lt;/tr&gt;
                      &lt;tr&gt;
                        &lt;td style=&quot;font-family: Calibri, sans-serif; font-size: 15px;&quot;&gt;
                          &lt;p&gt;Best Regards&lt;/p&gt;
                        &lt;/td&gt;
                      &lt;/tr&gt;
                    &lt;/tbody&gt;
                  &lt;/table&gt;
                &lt;/td&gt;
              &lt;/tr&gt;
&lt;tr&gt;
&lt;td style=&quot;width: 598px; height: 20px;&quot; align=&quot;center&quot;&gt;&lt;form action=&quot;{URL_RESTART}&quot; method=&quot;GET&quot;&gt;
&lt;div&gt;&lt;input id=&quot;v&quot; name=&quot;v&quot; type=&quot;hidden&quot; value=&quot;{VBELN}&quot; /&gt; &lt;input id=&quot;g&quot; name=&quot;g&quot; type=&quot;hidden&quot; value=&quot;{VGUID}&quot; /&gt; &lt;input id=&quot;j&quot; name=&quot;j&quot; type=&quot;hidden&quot; value=&quot;{JOBNR}&quot; /&gt;&lt;/div&gt;
&lt;div&gt;
&lt;div&gt;&lt;button style=&quot;font-size: 14px; font-family: Helvetica, Arial, sans-serif; color: #102259; text-decoration: underline; display: inline-block; background-color: #ffffff; padding: 12px 18px 12px 18px; border-radius: 5px; border: none;&quot;&gt;changed your mind? &amp;rarr;&lt;/button&gt;&lt;/div&gt;
&lt;/div&gt;
&lt;/form&gt;&lt;/td&gt;
&lt;/tr&gt;
            &lt;/tbody&gt;
          &lt;/table&gt;
        &lt;/td&gt;
      &lt;/tr&gt;
    &lt;/tbody&gt;
  &lt;/table&gt;
&lt;/body&gt;
&lt;/html&gt;
</BODY_HTML>
      <AUTOGEN_TXT>X</AUTOGEN_TXT>
