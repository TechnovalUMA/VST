    </HEADER>
    <HEADER_T>
     <SMTG_TMPL_HDR_T>
      <ID>ZVSSJAD_JOB_DEFER_CONF</ID>
      <VERSION>A</VERSION>
      <LANGU>E</LANGU>
      <NAME>VSS Job Confirmation</NAME>
     </SMTG_TMPL_HDR_T>
    </HEADER_T>
    <CONTENT>
     <SMTG_TMPL_CONT>
      <ID>ZVSSJAD_JOB_DEFER_CONF</ID>
      <VERSION>A</VERSION>
      <LANGU>E</LANGU>
      <SUBJECT>Request to approve additional tasks</SUBJECT>
      <BODY_TXT>Dear Customer,
Thank you very much for letting us know!
We will follow up on
.
Additional tasks identified for the vehicle {LIC_PLATE}.
Job descripton: {JOB_DESCRIPTION}
Estimated cost: {COST} {CURRENCY}
changed your mind? &amp;rarr;</BODY_TXT>
      <BODY_HTML>&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;body&gt;
  &lt;table style=&quot;border-collapse: collapse;&quot; border=&quot;0&quot; width=&quot;100%&quot; cellspacing=&quot;0&quot; cellpadding=&quot;20&quot;&gt;
    &lt;tbody&gt;
      &lt;tr&gt;
        &lt;td&gt;
          &lt;table style=&quot;border: 1px solid #cccccc; border-collapse: collapse; height: 272px;&quot; width=&quot;600&quot; cellspacing=&quot;0&quot; cellpadding=&quot;0&quot; align=&quot;center&quot;&gt;
            &lt;tbody&gt;
              &lt;tr style=&quot;height: 81px;&quot;&gt;
                &lt;td style=&quot;color: #ffffff; padding: 20px 30px; font-family: Arial, sans-serif; font-size: 20px; height: 81px; width: 538px;&quot; align=&quot;right&quot; bgcolor=&quot;#1F497D&quot;&gt;&lt;img style=&quot;display: block;&quot; src=&quot;{LOGO_BASE64}&quot; alt=&quot;Logo&quot; width=&quot;81&quot; height=&quot;81&quot;&gt;&lt;/td&gt;
              &lt;/tr&gt;
              &lt;tr style=&quot;height: 172px;&quot;&gt;
                &lt;td style=&quot;padding: 20px 10px 30px; font-family: Calibri, open-sans; font-size: 15px; height: 172px; width: 598px;&quot;&gt;
                  &lt;p&gt;Dear Customer,&lt;/p&gt;
                  &lt;p&gt;Thank you very much for letting us know!&lt;/p&gt;
                  &lt;p&gt;We will follow up on &lt;strong&gt;&lt;span id=&quot;follow_up&quot;&gt;&lt;/span&gt;
                  &lt;script&gt;
                  var dt = new Date(&quot;{FOLLOW_UP}&quot;);
                  document.getElementById(&quot;follow_up&quot;).innerHTML=dt.toLocaleString(navigator.language,{weekday: &apos;long&apos;, year:&apos;numeric&apos;, month: &apos;long&apos;,day: &apos;numeric&apos;,});
                  &lt;/script&gt;.&lt;/strong&gt;&lt;/p&gt;
                  &lt;p&gt;Additional tasks identified for the vehicle &lt;strong&gt;{LIC_PLATE}&lt;/strong&gt;.&lt;/p&gt;
                  &lt;p&gt;Job descripton: &lt;strong&gt;{JOB_DESCRIPTION}&lt;/strong&gt;&lt;/p&gt;
                  &lt;p&gt;Estimated cost: &lt;strong&gt;{COST} {CURRENCY}&lt;/strong&gt;&lt;/p&gt;
                &lt;/td&gt;
              &lt;/tr&gt;
&lt;tr&gt;
&lt;td style=&quot;width: 598px; height: 20px;&quot; align=&quot;center&quot;&gt;&lt;form action=&quot;{URL_RESTART}&quot; method=&quot;GET&quot;&gt;
&lt;div&gt;&lt;input id=&quot;v&quot; name=&quot;v&quot; type=&quot;hidden&quot; value=&quot;{VBELN}&quot; /&gt; &lt;input id=&quot;g&quot; name=&quot;g&quot; type=&quot;hidden&quot; value=&quot;{VGUID}&quot; /&gt; &lt;input id=&quot;j&quot; name=&quot;j&quot; type=&quot;hidden&quot; value=&quot;{JOBNR}&quot; /&gt;&lt;/div&gt;
&lt;div&gt;
&lt;div&gt;&lt;button style=&quot;font-size: 14px; font-family: Helvetica, Arial, sans-serif; color: #102259; text-decoration: underline; display: inline-block; background-color: #ffffff; padding: 12px 18px 12px 18px; border-radius: 5px; border: none;&quot;&gt;changed your mind? &amp;rarr;&lt;/button&gt;&lt;/div&gt;
&lt;/div&gt;
&lt;/form&gt;&lt;/td&gt;
&lt;/tr&gt;
            &lt;/tbody&gt;
          &lt;/table&gt;
        &lt;/td&gt;
      &lt;/tr&gt;
    &lt;/tbody&gt;
  &lt;/table&gt;
&lt;/body&gt;
&lt;/html&gt;
</BODY_HTML>
      <AUTOGEN_TXT>X</AUTOGEN_TXT>
     </SMTG_TMPL_CONT>
